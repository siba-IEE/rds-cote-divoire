    given-names: Siba
    affiliation: "Kuma Science"
license: CC-BY-4.0
repository-code: "https://github.com/siba-IEE/rds-cote-divoire"
url: "https://github.com/siba-IEE/rds-cote-divoire"
version: "1.0.0"
keywords:
  - "énergie solaire"
  - "Côte d'Ivoire"
  - "gisement solaire"
  - "données ouvertes"
  - "photovoltaïque"
